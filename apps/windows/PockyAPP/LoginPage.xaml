<Page
    x:Class="PockyAPP.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PockyAPP">
    <Grid Background="{ThemeResource PockyBgBrush}">
        <local:ThemeButton HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,12,0" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="400" Margin="24,40" VerticalAlignment="Center" Spacing="6">
                <TextBlock Text="PockyAPP" FontSize="34" FontWeight="Bold" Foreground="{ThemeResource PockyInkBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="Subtitle" Foreground="{ThemeResource PockyInkMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,24" TextAlignment="Center" TextWrapping="Wrap" />

                <TextBlock x:Name="UsernameLabel" Foreground="{ThemeResource PockyInkBrush}" FontWeight="SemiBold" />
                <TextBox x:Name="Username" TextChanged="OnFieldChanged" KeyDown="OnKeyDown" />

                <TextBlock x:Name="PasswordLabel" Foreground="{ThemeResource PockyInkBrush}" FontWeight="SemiBold" Margin="0,12,0,0" />
                <PasswordBox x:Name="Password" PasswordChanged="OnFieldChanged" KeyDown="OnKeyDown" />

                <Expander x:Name="ServerExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,12,0,0" Background="{ThemeResource PockySurfaceBrush}">
                    <TextBox x:Name="Server" TextChanged="OnFieldChanged" KeyDown="OnKeyDown" />
                </Expander>

                <TextBlock x:Name="ErrorText" Foreground="#ef4444" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" />

                <Button x:Name="SignInButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="0,10" Margin="0,16,0,0" Click="OnSignIn" IsEnabled="False" />
                <ProgressRing x:Name="Busy" Width="22" Height="22" IsActive="False" Visibility="Collapsed" Margin="0,8,0,0" />
                <Button x:Name="RegisterButton" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Click="OnRegister" Foreground="{ThemeResource PockyAccentSoftBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
