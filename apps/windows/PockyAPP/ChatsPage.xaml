<Page
    x:Class="PockyAPP.ChatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PockyAPP">
    <Page.Resources>
        <DataTemplate x:Key="RoomTemplate" x:DataType="local:RoomRow">
            <Grid Padding="4,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <PersonPicture Width="46" Height="46" DisplayName="{x:Bind Name, Mode=OneWay}" ProfilePicture="{x:Bind Avatar, Mode=OneWay}" />
                <Grid Grid.Column="1" VerticalAlignment="Center" RowSpacing="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource PockyInkBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Time, Mode=OneWay}" FontSize="12" Margin="8,0,0,0" Foreground="{ThemeResource PockyInkMutedBrush}" Visibility="{x:Bind ShowMeta, Mode=OneWay}" />
                    <TextBlock Grid.Row="1" Text="{x:Bind Preview, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="{ThemeResource PockyInkMutedBrush}" />
                    <Border Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" MinWidth="20" Height="20" CornerRadius="10" Padding="6,0" Background="{ThemeResource PockyAccentBrush}" Visibility="{x:Bind HasUnread, Mode=OneWay}">
                        <TextBlock Text="{x:Bind UnreadText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" Visibility="{x:Bind ShowInviteActions, Mode=OneWay}">
                        <Button Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind}" Click="OnAccept" Content="{x:Bind AcceptText}" />
                        <Button Tag="{x:Bind}" Click="OnDecline" Content="{x:Bind DeclineText}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource PockyBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Background="{ThemeResource PockySurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="16,4,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderTitle" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource PockyInkBrush}" VerticalAlignment="Center" />
                <local:ThemeButton Grid.Column="1" />
                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="10,8">
                    <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource PockyInkMutedBrush}" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="SignOutItem" Click="OnSignOut">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xF3B1;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <TextBox x:Name="Search" Grid.Row="1" Margin="16,8,16,8" TextChanged="OnSearch" />
            <TextBlock x:Name="StatusText" Grid.Row="2" Margin="18,0,16,6" FontSize="12" Foreground="{ThemeResource PockyInkMutedBrush}" Visibility="Collapsed" />
            <ListView x:Name="RoomList" Grid.Row="3" ItemTemplate="{StaticResource RoomTemplate}" SelectionChanged="OnSelected" Padding="8,0" />
            <TextBlock x:Name="EmptyText" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" Foreground="{ThemeResource PockyInkMutedBrush}" Visibility="Collapsed" />
        </Grid>

        <Rectangle Grid.Column="1" Fill="{ThemeResource PockyInkMutedBrush}" Opacity="0.2" />

        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
            <TextBlock Text="PockyAPP" FontSize="30" FontWeight="Bold" Foreground="{ThemeResource PockyInkBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="Placeholder" Foreground="{ThemeResource PockyInkMutedBrush}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
