<Window
    x:Class="PockyAPP.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource PockyBgBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock Text="PockyAPP" FontSize="36" FontWeight="Bold" Foreground="{ThemeResource PockyInkBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="VersionText" Foreground="{ThemeResource PockyInkMutedBrush}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
