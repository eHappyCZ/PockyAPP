<Window
    x:Class="PockyAPP.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource PockyBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Grid.Row="0">
            <TextBlock Text="PockyAPP" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" Foreground="{ThemeResource PockyInkMutedBrush}" />
        </Grid>
        <Frame x:Name="Host" Grid.Row="1" />
        <ProgressRing x:Name="Spinner" Grid.Row="1" Width="36" Height="36" IsActive="True" Foreground="{ThemeResource PockyAccentBrush}" />
    </Grid>
</Window>
