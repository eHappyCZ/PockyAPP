<Page
    x:Class="PockyAPP.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PockyAPP">
    <Grid Background="{ThemeResource PockyBgBrush}">
        <Button x:Name="BackButton" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,4,0,0" Click="OnBack">
            <FontIcon Glyph="&#xE72B;" FontSize="16" Foreground="{ThemeResource PockyInkBrush}" />
        </Button>
        <local:ThemeButton HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,12,0" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="400" Margin="24,56,24,40" VerticalAlignment="Center" Spacing="6">
                <TextBlock x:Name="Title" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource PockyInkBrush}" />
                <TextBlock x:Name="Subtitle" Foreground="{ThemeResource PockyInkMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />

                <TextBlock x:Name="UsernameLabel" Foreground="{ThemeResource PockyInkBrush}" FontWeight="SemiBold" />
                <TextBox x:Name="Username" TextChanged="OnFieldChanged" KeyDown="OnKeyDown" />

                <TextBlock x:Name="PasswordLabel" Foreground="{ThemeResource PockyInkBrush}" FontWeight="SemiBold" Margin="0,12,0,0" />
                <PasswordBox x:Name="Password" PasswordChanged="OnFieldChanged" KeyDown="OnKeyDown" />
                <TextBlock x:Name="PasswordHint" Foreground="{ThemeResource PockyInkMutedBrush}" FontSize="12" />

                <TextBlock x:Name="InviteLabel" Foreground="{ThemeResource PockyInkBrush}" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBox x:Name="Invite" TextChanged="OnFieldChanged" KeyDown="OnKeyDown" />

                <TextBlock x:Name="ErrorText" Foreground="#ef4444" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" />

                <Button x:Name="SubmitButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="0,10" Margin="0,16,0,0" Click="OnSubmit" IsEnabled="False" />
                <ProgressRing x:Name="Busy" Width="22" Height="22" IsActive="False" Visibility="Collapsed" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
